# Database
DATABASE_URL="postgresql://user:password@localhost:5432/openfolio?schema=public"

# Supabase (alternative to local PostgreSQL)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Keys (optional - ETL will use seed data if not provided)
FRED_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
FMP_API_KEY=""
OPENAI_API_KEY=""

# Rate Limits
FRED_REQUESTS_PER_DAY=120
ALPHA_VANTAGE_REQUESTS_PER_MIN=5
