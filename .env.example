# Supabase (Required for both Frontend and ETL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Alternative names (ETL will check these if NEXT_PUBLIC_* not found)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-anon-key"

# API Keys (optional - ETL will use seed data if not provided)
FRED_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
FMP_API_KEY=""
OPENAI_API_KEY=""

# SEC EDGAR (Required for filings)
SEC_USER_AGENT="YourApp your@email.com"

# ETL Performance
ETL_CALCULATION_DAYS=7  # Days to calculate for Phase 2 (default: 7, set to 90 for full backfill)

# Rate Limits
FRED_REQUESTS_PER_DAY=120
ALPHA_VANTAGE_REQUESTS_PER_MIN=5
